#!/usr/bin/env bash
# Refuse a push whose added lines contain a private term. Nothing else gates a push.
terms="${PRIVATE_TERMS:-$HOME/.claude/private-terms.txt}"
[ -f "$terms" ] || exit 0
pattern=$(grep -v -e '^#' -e '^$' "$terms" | paste -sd'|' -)
[ -n "$pattern" ] || exit 0
base=$(git rev-parse -q --verify '@{u}' || git rev-parse -q --verify origin/main || git hash-object -t tree /dev/null)
hits=$(git diff "$base" HEAD -U0 --no-color | grep -E '^\+' | grep -v -E '^\+\+\+' | grep -i -n -E "(^|[^[:alnum:]])($pattern)([^[:alnum:]]|$)")
if [ -n "$hits" ]; then
  echo "pre-push: private terms in pushed lines:" >&2
  echo "$hits" | cut -c1-160 >&2
  exit 1
fi
